{
  "manifest_version": 3,
  "name": "Campaigner UTM Auditor",
  "version": "1.1",
  "description": "Audits internal SFU links for required Campaigner UTM tracking parameters.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check UTM Tracking",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}